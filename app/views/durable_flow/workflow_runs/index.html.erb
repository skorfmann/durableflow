<div class="df-header">
  <div>
    <div class="df-kicker">DurableFlow</div>
    <h1>Workflow Runs</h1>
    <p class="df-muted">Recent executions, waits, sleeps, and terminal states across your Rails workflows.</p>
  </div>
  <%= link_to "Refresh", workflow_runs_path, class: "df-button" %>
</div>

<div class="df-stats">
  <div class="df-stat">
    <div class="df-stat-label">Total runs</div>
    <div class="df-stat-value"><%= @workflow_runs.size %></div>
  </div>
  <div class="df-stat">
    <div class="df-stat-label">Active</div>
    <div class="df-stat-value"><%= @active_count %></div>
  </div>
  <div class="df-stat">
    <div class="df-stat-label">Completed</div>
    <div class="df-stat-value"><%= @status_counts.fetch("completed", 0) %></div>
  </div>
  <div class="df-stat">
    <div class="df-stat-label">Failed</div>
    <div class="df-stat-value"><%= @status_counts.fetch("failed", 0) %></div>
  </div>
</div>

<section class="df-panel">
  <div class="df-panel-header">
    <div>
      <div class="df-panel-title">Runs</div>
      <div class="df-panel-subtitle">Showing latest <%= @workflow_runs.size %> workflow runs</div>
    </div>
    <div class="df-filter">Filter by run, workflow, status</div>
  </div>

  <table>
    <thead>
      <tr>
        <th style="width: 34%">Run</th>
        <th style="width: 18%">Status</th>
        <th class="df-hide-sm" style="width: 15%">Duration</th>
        <th class="df-hide-sm" style="width: 17%">Started</th>
        <th style="width: 16%">Updated</th>
      </tr>
    </thead>
    <tbody>
      <% @workflow_runs.each do |run| %>
        <% finished_at = run.completed_at || run.failed_at %>
        <tr>
          <td>
            <%= link_to run.workflow_class, workflow_run_path(run.run_id), class: "df-run-link" %>
            <div class="df-run-id df-mono"><%= run.run_id %></div>
          </td>
          <td>
            <span class="df-status <%= durable_flow_status_class(run.status) %>"><%= run.status %></span>
          </td>
          <td class="df-hide-sm"><%= durable_flow_duration(run.started_at || run.created_at, finished_at) %></td>
          <td class="df-hide-sm"><%= durable_flow_format_time(run.started_at || run.created_at) %></td>
          <td><%= durable_flow_format_time(run.updated_at) %></td>
        </tr>
      <% end %>

      <% if @workflow_runs.empty? %>
        <tr>
          <td colspan="5">
            <div class="df-empty">No workflow runs yet.</div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
