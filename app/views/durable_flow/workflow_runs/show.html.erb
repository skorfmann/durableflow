<div class="df-header">
  <div>
    <div class="df-kicker"><%= link_to "Workflow Runs", workflow_runs_path %> / Run</div>
    <h1><%= @workflow_run.workflow_class %></h1>
    <p class="df-muted df-mono"><%= @workflow_run.run_id %></p>
  </div>
  <div class="df-header-actions">
    <%= link_to "Definition DAG", definition_workflow_run_path(@workflow_run.run_id), class: "df-button" %>
    <span class="df-status <%= durable_flow_status_class(@workflow_run.status) %>"><%= @workflow_run.status %></span>
  </div>
</div>

<div class="df-meta-grid">
  <div class="df-meta">
    <div class="df-meta-label">Duration</div>
    <div class="df-meta-value"><%= durable_flow_duration(@workflow_run.started_at || @workflow_run.created_at, @workflow_run.completed_at || @workflow_run.failed_at) %></div>
  </div>
  <div class="df-meta">
    <div class="df-meta-label">Started</div>
    <div class="df-meta-value"><%= durable_flow_format_time(@workflow_run.started_at || @workflow_run.created_at) %></div>
  </div>
  <div class="df-meta">
    <div class="df-meta-label">Interrupted</div>
    <div class="df-meta-value"><%= durable_flow_format_time(@workflow_run.interrupted_at) %></div>
  </div>
  <div class="df-meta">
    <div class="df-meta-label">Updated</div>
    <div class="df-meta-value"><%= durable_flow_format_time(@workflow_run.updated_at) %></div>
  </div>
</div>

<div class="df-detail-grid">
  <section class="df-panel">
    <div class="df-panel-header">
      <div>
        <div class="df-panel-title">Timeline</div>
        <div class="df-panel-subtitle"><%= pluralize(@workflow_timeline.step_entries.size, "step") %> recorded for this run</div>
      </div>
    </div>

    <div class="df-timeline">
      <% @workflow_timeline.step_entries.each do |entry| %>
        <% step = entry.step %>
        <article class="df-step">
          <div class="df-step-rail">
            <span class="df-step-dot <%= durable_flow_status_class(step.status) %>"></span>
          </div>
          <div class="df-step-body">
            <div class="df-step-top">
              <div>
                <div class="df-step-name"><%= step.name %></div>
                <div class="df-step-meta">
                  Attempt <%= step.attempts %>
                  · Started <%= durable_flow_format_time(step.started_at) %>
                  <% if step.completed_at %>
                    · Completed <%= durable_flow_format_time(step.completed_at) %>
                  <% end %>
                </div>
              </div>
              <span class="df-status <%= durable_flow_status_class(step.status) %>"><%= step.status %></span>
            </div>

            <% if step.metadata.present? %>
              <pre class="df-code"><%= durable_flow_json(step.metadata) %></pre>
            <% end %>

            <% if step.result.present? %>
              <pre class="df-code"><%= durable_flow_json(step.result) %></pre>
            <% end %>

            <% if entry.logs.any? %>
              <div class="df-step-logs">
                <div class="df-step-logs-label">Logs</div>
                <% entry.logs.each do |log| %>
                  <div class="df-step-log">
                    <div class="df-step-log-top">
                      <span class="df-status <%= durable_flow_status_class(log.level) %>"><%= log.level %></span>
                      <span class="df-step-log-message"><%= log.message %></span>
                    </div>
                    <% if log.data.present? %>
                      <pre class="df-code"><%= durable_flow_json(log.data_value) %></pre>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>

      <% if @workflow_timeline.step_entries.empty? %>
        <div class="df-empty">No steps recorded yet.</div>
      <% end %>
    </div>
  </section>

  <aside class="df-panel">
    <div class="df-panel-header">
      <div>
        <div class="df-panel-title">Run Details</div>
        <div class="df-panel-subtitle">Queue, arguments, waits, and errors</div>
      </div>
    </div>

    <div class="df-side-section">
      <h3>Metadata</h3>
      <div class="df-kv">
        <div class="df-kv-key">Job ID</div>
        <div class="df-kv-value df-mono"><%= @workflow_run.job_id %></div>
      </div>
      <div class="df-kv">
        <div class="df-kv-key">Queue</div>
        <div class="df-kv-value"><%= @workflow_run.queue_name.presence || "default" %></div>
      </div>
      <div class="df-kv">
        <div class="df-kv-key">Priority</div>
        <div class="df-kv-value"><%= @workflow_run.priority || "—" %></div>
      </div>
      <div class="df-kv">
        <div class="df-kv-key">Lock</div>
        <div class="df-kv-value"><%= @workflow_run.execution_locked? ? "active until #{durable_flow_format_time(@workflow_run.execution_lock_expires_at)}" : "not locked" %></div>
      </div>
    </div>

    <% if @workflow_timeline.waits.any? %>
      <div class="df-side-section">
        <h3>Waits</h3>
        <% @workflow_timeline.waits.each do |wait| %>
          <div class="df-kv">
            <div class="df-kv-key">Event</div>
            <div class="df-kv-value"><%= wait.event_name %></div>
          </div>
          <div class="df-kv">
            <div class="df-kv-key">Status</div>
            <div class="df-kv-value">
              <span class="df-status <%= durable_flow_status_class(wait.status) %>"><%= wait.status %></span>
            </div>
          </div>
          <div class="df-kv">
            <div class="df-kv-key">Timeout</div>
            <div class="df-kv-value"><%= durable_flow_format_time(wait.timeout_at) %></div>
          </div>
          <pre class="df-code"><%= durable_flow_json(wait.match) %></pre>
          <% if wait.workflow_event %>
            <pre class="df-code"><%= durable_flow_json(wait.workflow_event.payload) %></pre>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @workflow_timeline.run_logs.any? %>
      <div class="df-side-section">
        <h3>Run Logs</h3>
        <% @workflow_timeline.run_logs.each do |log| %>
          <div class="df-kv">
            <div class="df-kv-key"><%= durable_flow_format_time(log.created_at) %></div>
            <div class="df-kv-value">
              <span class="df-status <%= durable_flow_status_class(log.level) %>"><%= log.level %></span>
              <div style="margin-top: 8px; font-weight: 650;"><%= log.message %></div>
              <% if log.data.present? %>
                <pre class="df-code"><%= durable_flow_json(log.data_value) %></pre>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @workflow_run.arguments.present? %>
      <div class="df-side-section">
        <h3>Arguments</h3>
        <pre class="df-code"><%= durable_flow_json(@workflow_run.arguments) %></pre>
      </div>
    <% end %>

    <% if @workflow_run.last_error.present? %>
      <div class="df-side-section">
        <h3>Error</h3>
        <pre class="df-code"><%= durable_flow_json(@workflow_run.last_error) %></pre>
      </div>
    <% end %>
  </aside>
</div>
